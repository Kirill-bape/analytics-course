{
  "name": "analytics-course",
  "private": true,
  "version": "1.0.0",
  "description": "Путь аналитика — приложение для самостоятельного изучения аналитики данных",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "generate-data": "node scripts/generate-data.mjs",
    "setup-python": "node scripts/fetch-pyodide.mjs",
    "postinstall": "node scripts/fetch-pyodide.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@lezer/highlight": "^1.2.5",
    "apache-arrow": "^17.0.0",
    "codemirror": "^6.0.2",
    "hyperformula": "^3.4.0",
    "marked": "^18.0.14",
    "pyodide": "^314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "GPL-3.0-only"
}
